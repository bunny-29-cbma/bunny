# Attendix Environment Configuration

# Base URL of the College IMS Portal (default: MITS IMS)
IMS_BASE_URL=http://mitsims.in

# Demo Mode: Set to "true" to enable mock data for preview/demonstrations
DEMO_MODE=false

# Flask Secret Key
SECRET_KEY=attendix-secure-session-key-change-in-production

# Optional credentials for local testing (Never commit real credentials)
TEST_USERNAME=
TEST_PASSWORD=
